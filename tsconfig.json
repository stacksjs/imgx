{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "moduleDetection": "force",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "noEmit": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedDeclarations": true,
    "verbatimModuleSyntax": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    // No `baseUrl`: TypeScript 7 removed it. The paths below are written
    // relative to this file, which is how they resolve without one.
    "paths": {
      "ts-images": ["./packages/ts-images/src/index.ts"],
      "ts-images/*": ["./packages/ts-images/src/*"]
    }
  },
  "exclude": [
    "pickier.config.ts",
    "buddy-bot.config.ts",
    "docs/bunpress.config.ts",
    "imgx.config.ts",
    "pantry"
  ]
}
